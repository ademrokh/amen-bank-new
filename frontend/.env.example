# =========================
# SMTP / Email configuration
# =========================
# Use SMTP credentials to send outgoing mail (Gmail app password example shown)
# If SMTP_* variables are not set the routes will log submissions but will NOT send emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=example@mail.com
SMTP_PASS=your_smtp_or_app_password

# The From address used for outgoing mail
SENDER_EMAIL=example@mail.com

# Primary admin recipient for password/admin emails. If set, this is used as the To address.
PASSWORD_RECEIVER_EMAIL=example@mail.com

# Optionally provide a comma-separated list of admin emails (first entry is used if PASSWORD_RECEIVER_EMAIL not set)
# ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Backwards-compatible Gmail-specific variables (optional)
# GMAIL_ADDRESS=example@mail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password

# =========================
# Frontend / Next.js public vars
# =========================
# Supabase (used for admin auth and other features)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_public_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# =========================
# Optional / legacy or alternative configs
# =========================
# EMAIL_RECIPIENT=alternate_admin@example.com
# SENDGRID_API_KEY=your_sendgrid_api_key        # kept as optional legacy variable; we use SMTP by default

# =========================
# Notes
# - Copy this file to `.env.local` in the `frontend` folder and populate real values.
# - NEVER commit real secrets to source control.
# - After editing `.env.local`, restart the dev server so Next picks up new env values.
